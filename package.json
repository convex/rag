{
  "name": "@convex-dev/rag",
  "description": "Convex component for RAG: chunk and embed documents, then run semantic search to build LLM context.",
  "repository": "github:convex/rag",
  "homepage": "https://www.convex.dev/components/rag",
  "bugs": {
    "email": "support@convex.dev",
    "url": "https://github.com/convex/rag/issues"
  },
  "version": "0.7.9",
  "license": "Apache-2.0",
  "keywords": [
    "convex",
    "component",
    "rag",
    "retrieval-augmented-generation",
    "semantic-search",
    "vector-search",
    "embeddings",
    "llm",
    "ai",
    "document-chunking"
  ],
  "type": "module",
  "scripts": {
    "setup": "npm i && npm run dev:backend -- --once && printf 'VITE_CONVEX_SITE_URL=' >> .env.local && npx convex env get CONVEX_SITE_URL >> .env.local",
    "dev": "convex dev --start 'npm run dev:build'",
    "dev:frontend": "cd example && vite --clearScreen false",
    "dev:build": "chokidar 'tsconfig*.json' 'src/**/*.ts' -i '**/*.test.ts' -c 'npm run build:codegen' --initial",
    "predev": "convex init && npm run build:codegen",
    "build": "tsc --project ./tsconfig.build.json",
    "prepack": "npm run build",
    "build:codegen": "npx convex codegen --component-dir ./src/component && npm run build",
    "build:clean": "rm -rf dist *.tsbuildinfo && npm run build:codegen",
    "typecheck": "tsc --noEmit && tsc -p example && tsc -p example/convex",
    "lint": "eslint .",
    "check:circular": "madge src/component/ --extensions ts --exclude api.ts --circular",
    "check": "npm run test && npm run typecheck && npm run lint && npm run check:circular",
    "test": "vitest run --typecheck",
    "test:e2e": "convex dev --once --typecheck-components",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "dependencies": {
    "@convex-dev/workpool": "^0.4.4"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.127"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.25",
    "@arethetypeswrong/cli": "0.18.2",
    "@changesets/cli": "3.0.3",
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@convex-dev/workpool": "0.4.6",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@langchain/textsplitters": "1.0.1",
    "@tailwindcss/postcss": "4.1.18",
    "@tailwindcss/typography": "0.5.19",
    "@types/eslint-plugin-react-refresh": "0.4.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "@vitejs/plugin-react": "5.1.3",
    "ai": "7.0.43",
    "autoprefixer": "10.4.24",
    "chokidar-cli": "3.0.0",
    "convex": "1.46.0",
    "convex-helpers": "0.1.127",
    "convex-test": "0.0.64",
    "eslint": "9.39.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.0",
    "globals": "17.3.0",
    "madge": "8.0.0",
    "pdfjs-dist": "6.0.227",
    "pkg-pr-new": "0.0.63",
    "postcss": "8.5.6",
    "prettier": "3.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "^7.3.3",
    "vitest": "5.0.0"
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js"
}

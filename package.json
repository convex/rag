{
  "name": "@convex-dev/rag",
  "description": "Convex component for RAG: chunk and embed documents, then run semantic search to build LLM context.",
  "repository": "github:convex/rag",
  "homepage": "https://www.convex.dev/components/rag",
  "bugs": {
    "email": "support@convex.dev",
    "url": "https://github.com/convex/rag/issues"
  },
  "version": "0.7.9",
  "license": "Apache-2.0",
  "keywords": [
    "convex",
    "component",
    "rag",
    "retrieval-augmented-generation",
    "semantic-search",
    "vector-search",
    "embeddings",
    "llm",
    "ai",
    "document-chunking"
  ],
  "type": "module",
  "scripts": {
    "setup": "npm i && npm run dev:backend -- --once && printf 'VITE_CONVEX_SITE_URL=' >> .env.local && npx convex env get CONVEX_SITE_URL >> .env.local",
    "dev": "convex dev --start 'npm run dev:build'",
    "dev:frontend": "cd example && vite --clearScreen false",
    "dev:build": "chokidar 'tsconfig*.json' 'src/**/*.ts' -i '**/*.test.ts' -c 'npm run build:codegen' --initial",
    "predev": "convex init && npm run build:codegen",
    "build": "tsc --project ./tsconfig.build.json",
    "prepack": "npm run build",
    "build:codegen": "npx convex codegen --component-dir ./src/component && npm run build",
    "build:clean": "rm -rf dist *.tsbuildinfo && npm run build:codegen",
    "typecheck": "tsc --noEmit && tsc -p example && tsc -p example/convex",
    "lint": "eslint .",
    "check:circular": "madge src/component/ --extensions ts --exclude api.ts --circular",
    "check": "npm run test && npm run typecheck && npm run lint && npm run check:circular",
    "test": "vitest run --typecheck",
    "test:e2e": "convex dev --once --typecheck-components",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "dependencies": {
    "@convex-dev/workpool": "^0.4.4"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.127"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.114",
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@convex-dev/eslint-plugin": "5.0.0",
    "@convex-dev/workpool": "0.4.16",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@langchain/textsplitters": "1.0.2",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/typography": "0.5.20",
    "@types/eslint-plugin-react-refresh": "0.4.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "@vitejs/plugin-react": "5.2.0",
    "ai": "7.0.169",
    "autoprefixer": "10.6.2",
    "chokidar-cli": "3.0.0",
    "convex": "1.49.0",
    "convex-helpers": "0.1.135",
    "convex-test": "0.0.69",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "madge": "8.0.0",
    "pdfjs-dist": "6.5.438",
    "pkg-pr-new": "0.0.93",
    "postcss": "8.5.32",
    "prettier": "3.10.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.6",
    "vitest": "5.1.0"
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js"
}
